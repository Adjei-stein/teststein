{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "teststein.yml",
  "description": "Defines test jobs that Teststein runners execute. See packages/spec/teststein-yml.md.",
  "type": "object",
  "required": ["version", "jobs"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "File format version."
    },
    "jobs": {
      "type": "object",
      "description": "Jobs keyed by a stable id. Renaming a key creates a new job (and a new history).",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
      "additionalProperties": { "$ref": "#/$defs/job" }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(s|m|h)$",
      "description": "e.g. 90s, 30m, 2h"
    },
    "command": {
      "description": "A shell command, or a list of commands run in order.",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "glob": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    },
    "service": {
      "oneOf": [
        {
          "enum": ["chrome", "firefox", "edge", "appium"],
          "description": "Preset: chrome/firefox/edge start a Selenium standalone browser at http://<name>:4444; appium starts an Appium 2 server with UiAutomator2 at http://appium:4723."
        },
        {
          "type": "object",
          "required": ["name", "image"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$", "description": "Hostname the job uses to reach the service." },
            "image": { "type": "string", "minLength": 1 },
            "env": { "$ref": "#/$defs/env" },
            "command": { "$ref": "#/$defs/command" }
          }
        }
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "Branch names or globs, e.g. main, release/*"
    },
    "job": {
      "type": "object",
      "required": ["framework"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string" },
        "framework": {
          "enum": ["pytest", "mocha", "playwright", "cypress", "junit5", "testng", "locust"],
          "description": "The test runner. Selenium, Appium and Playwright for Python/Java run under pytest, junit5 or testng; list them in `libraries`."
        },
        "build_tool": { "enum": ["pip", "npm", "maven", "gradle"] },
        "libraries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["selenium", "appium", "playwright"] }
        },
        "runtime": {
          "type": "string",
          "pattern": "^(python|node|java):[0-9]+(\\.[0-9]+)*$",
          "description": "Language version for the default image, e.g. python:3.12, node:20, java:21."
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Use your own container image instead of the default for the framework."
        },
        "working_directory": { "type": "string", "description": "Relative to the script source root." },
        "install": { "$ref": "#/$defs/command" },
        "command": { "$ref": "#/$defs/command" },
        "environment": {
          "type": "string",
          "description": "Default project environment (e.g. Staging). Can be overridden when triggering."
        },
        "env": { "$ref": "#/$defs/env" },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "runs_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]*$" },
          "description": "Labels a runner must have, e.g. [self-hosted, kvm]."
        },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "junit": { "$ref": "#/$defs/glob" }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "required": ["path"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "kind": { "enum": ["log", "screenshot", "video", "trace", "report", "other"] },
                  "when": { "enum": ["always", "on_failure"], "default": "always" }
                }
              }
            ]
          }
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "shards": { "type": "integer", "minimum": 1, "maximum": 50 },
        "cache": {
          "description": "Extra paths to cache between runs, or false to disable the default dependency cache.",
          "oneOf": [
            { "const": false },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "triggers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "push": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "branches": { "$ref": "#/$defs/branches" } }
            },
            "pull_request": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "branches": { "$ref": "#/$defs/branches" },
                "report_status": { "type": "boolean", "default": true }
              }
            },
            "schedule": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["cron"],
                "additionalProperties": false,
                "properties": {
                  "cron": { "type": "string", "pattern": "^\\S+( \\S+){4}$" },
                  "timezone": { "type": "string" },
                  "environment": { "type": "string" },
                  "ref": { "type": "string" }
                }
              }
            }
          }
        },
        "load": {
          "type": "object",
          "required": ["users", "duration"],
          "additionalProperties": false,
          "properties": {
            "users": { "type": "integer", "minimum": 1 },
            "spawn_rate": { "type": "number", "exclusiveMinimum": 0, "description": "Users started per second." },
            "duration": { "$ref": "#/$defs/duration" },
            "workers": { "type": "integer", "minimum": 0, "maximum": 50, "description": "Locust worker processes; 0 = single process." },
            "host": { "type": "string", "description": "Target base URL; defaults to the environment's base URL." },
            "locustfile": { "type": "string" }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "avg_ms": { "type": "number", "exclusiveMinimum": 0 },
            "p50_ms": { "type": "number", "exclusiveMinimum": 0 },
            "p95_ms": { "type": "number", "exclusiveMinimum": 0 },
            "p99_ms": { "type": "number", "exclusiveMinimum": 0 },
            "max_error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "min_rps": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "emulator": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "api_level": { "type": "integer", "minimum": 24, "maximum": 40 },
                "device": { "type": "string", "description": "AVD device profile, e.g. pixel_7" }
              }
            },
            "device": {
              "type": "string",
              "description": "Use a real device: the runner label it is advertised under, e.g. android:device:pixel-7."
            },
            "app": { "type": "string", "description": "Path to the .apk inside the script source." }
          },
          "not": { "required": ["emulator", "device"] }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "framework": { "enum": ["junit5", "testng"] } } },
          "then": {
            "required": ["build_tool"],
            "properties": {
              "build_tool": { "enum": ["maven", "gradle"] },
              "runtime": { "pattern": "^java:" }
            }
          }
        },
        {
          "if": { "properties": { "framework": { "enum": ["pytest", "locust"] } } },
          "then": {
            "properties": {
              "build_tool": { "const": "pip" },
              "runtime": { "pattern": "^python:" }
            }
          }
        },
        {
          "if": { "properties": { "framework": { "enum": ["mocha", "playwright", "cypress"] } } },
          "then": {
            "properties": {
              "build_tool": { "const": "npm" },
              "runtime": { "pattern": "^node:" }
            }
          }
        },
        {
          "if": { "properties": { "framework": { "const": "locust" } } },
          "then": {
            "required": ["load"],
            "properties": { "libraries": { "maxItems": 0 }, "shards": { "const": 1 }, "retries": { "const": 0 } }
          },
          "else": {
            "properties": { "load": false, "thresholds": false }
          }
        },
        {
          "if": {
            "required": ["libraries"],
            "properties": { "libraries": { "contains": { "const": "appium" } } }
          },
          "then": { "required": ["android"] },
          "else": { "properties": { "android": false } }
        },
        {
          "if": { "properties": { "framework": { "enum": ["playwright", "cypress"] } } },
          "then": { "properties": { "libraries": { "maxItems": 0 } } }
        }
      ]
    }
  }
}

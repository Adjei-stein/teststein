# Copy to .env for local development.

# The API connects as the non-owner role so row-level security applies.
DATABASE_URL=postgres://teststein_app:teststein_app@localhost:5432/teststein
# Migrations run as the database owner.
MIGRATION_DATABASE_URL=postgres://teststein:teststein@localhost:5432/teststein
# Role that receives table privileges after migrations.
APP_DB_ROLE=teststein_app

# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me

PORT=3000
CORS_ORIGIN=http://localhost:4200
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP on sign-in and sign-up.
AUTH_RATE_LIMIT=10
